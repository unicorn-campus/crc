  "rls_policies": [
    {
      "schema": "public",
      "table": "card",
      "policy": "card_session_scope",
      "cmd": "SELECT",
      "roles": "{app_reader}",
      "qual": "(member_id = NULLIF(current_setting('app.member_id'::text, true), ''::text))"
    },
    {
      "schema": "public",
      "table": "card_txn",
      "policy": "card_txn_session_scope",
      "cmd": "SELECT",
      "roles": "{app_reader}",
      "qual": "(EXISTS ( SELECT 1\n   FROM card scoped_card\n  WHERE ((scoped_card.card_id = card_txn.card_id) AND (scoped_card.member_id = NULLIF(current_setting('app.member_id'::text, true), ''::text)))))"
    },
